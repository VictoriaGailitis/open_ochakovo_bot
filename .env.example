# Server only. Never prefix secrets with VITE_.
# Local: python3 scripts/setup-local.py creates ignored .env with generated password.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:55432/ochakovo
SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
# Enable only behind a trusted reverse proxy that owns X-Forwarded-Proto.
DJANGO_TRUST_PROXY=0
VK_APP_ID=
VK_APP_SECRET=
DEV_AUTH=0
ALLOWED_ORIGINS=
VK_LAUNCH_TTL=3600
