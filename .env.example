# Server configuration. Copy values into your deployment's secret store.
# These variables must never be prefixed with VITE_ or exposed to frontend builds.
VK_APP_ID=
VK_APP_SECRET=
ADMIN_TOKEN=

# Keep off in VK/public deployments. npm run dev opts in for localhost only.
DEV_AUTH=0
# Exact origins, separated by commas. Same-origin requests work automatically.
ALLOWED_ORIGINS=
VK_LAUNCH_TTL=3600
# Optional absolute path to frontend build, defaults to ./dist
# DIST_DIR=/app/dist
