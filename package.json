{
  "name": "ochakovo-inside",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "python3 -m server --host 127.0.0.1 --port 3001",
    "test": "python3 -m unittest discover -s server/tests -v && tsx --test src/*.test.ts src/games/*.test.ts",
    "check:deployment": "node scripts/check-deployment.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@vkontakte/vk-bridge": "^2.15.11",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "qrcode": "^1.5.4",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vite": "^6.4.0"
  }
}
